{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": {
      "master": true
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "portfolio-mu-eight-39.vercel.app"
        }
      ],
      "destination": "https://kanchansimlandi.vercel.app/:path*",
      "permanent": true
    }
  ]
}
